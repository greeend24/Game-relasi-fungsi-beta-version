{
  "name": "detektif-data-relasi-fungsi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "server": "cd backend && npm start",
    "backend:start": "cd backend && npm start",
    "play": "npm run build && npm run backend:build && electron .",
    "dev": "vite",
    "build": "vite build",
    "build:render": "vite build && npm --prefix backend run build",
    "start:render": "node backend/dist/index.js",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "backend:build": "cd backend && npm run build",
    "backend:dev": "cd backend && npx tsx watch src/index.ts",
    "electron:start": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "update:unpacked": "npm run build && npm run backend:build && node scripts/sync_unpacked.cjs",
    "electron:build": "npm run build && npm run backend:build && electron-builder build --win --x64 --config electron-builder.config.cjs",
    "dist": "npm run electron:build",
    "dist:windows": "node scripts/distribute_windows.cjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap open android",
    "cap:ios": "npm run build && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "better-auth": "^1.6.26",
    "canvas-confetti": "^1.9.4",
    "lottie-react": "^3.1.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "docx": "^9.7.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "omggif": "^1.0.10",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^9.1.0"
  }
}
